{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/cron/release-escrow/",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/cron/payout-cron/",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/cron/cleanup/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/cron/weekly-sales/",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/cron/payouts/",
      "schedule": "30 5 * * 5"
    }
  ],
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/static/(.*)\\.([0-9a-f]{12})\\.(css|js|png|jpg|jpeg|webp|svg|ico|woff|woff2|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/((?!.*\\.[0-9a-f]{12}\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}