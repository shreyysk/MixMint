# ── From https://my.telegram.org → API development tools (any app name) ──
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ── Same bot token as in Vercel ──
TELEGRAM_BOT_TOKEN=
# ── Long random string; put the SAME value in Vercel as VAULT_WORKER_SECRET ──
#    generate: openssl rand -hex 32
VAULT_WORKER_SECRET=
# ── Same R2 values as in Vercel ──
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# ── The subdomain pointing at this server (DNS A record), e.g. vault.mixmint.site ──
VAULT_DOMAIN=vault.mixmint.site
WORKERS=2
