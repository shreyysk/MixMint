# MixMint 2.0 - Django Environment Variables
# Copy this file to .env and update the values.

# --- DJANGO ---
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- DATABASE (PostgreSQL / Supabase) ---
# For Supabase, use the "Connection String" from the database settings.
# Transaction Pooler (SQLFR) via Port 6543 is recommended for Django.
# Example: postgres://postgres.yourprojectid:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://user:password@localhost:5432/mixmint

# --- APP URL ---
# Public base URL (used in payment return URLs, emails, sitemaps). No trailing slash.
BASE_URL=http://localhost:8000
# Reverse proxies in front of Django that append to X-Forwarded-For.
# 0 = local dev, 1 = Render/Railway/Vercel, 2 = Cloudflare in front of them.
NUM_PROXIES=0
# Production only: comma-separated https origins allowed to POST forms (defaults from ALLOWED_HOSTS)
# CSRF_TRUSTED_ORIGINS=https://mixmint.site
# Shared cache so rate limits/fraud counters work across workers (recommended in production)
# CACHE_URL=redis://localhost:6379/1

# --- PAYMENTS ---
# Choose default gateway: 'phonepe' or 'razorpay'
DEFAULT_PAYMENT_GATEWAY=razorpay

# Razorpay Configuration
# Pre-launch: use TEST keys (rzp_test_...) from Dashboard -> Test Mode -> API Keys. A yellow
# "TEST MODE" banner shows and no real money moves. Going live = swap in rzp_live_ keys + the
# live webhook secret, then redeploy. No code change.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Settings -> Webhooks -> secret (NOT the API key secret).
# Events: payment.captured, payment.failed, order.paid  URL: <BASE_URL>/api/v1/payments/webhook/razorpay/
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe Configuration
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# --- STORAGE (Cloudflare R2) ---
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=your_r2_s3_api_endpoint
# R2_BUCKET_NAME is still accepted as an alias for R2_PRIVATE_BUCKET.
R2_PRIVATE_BUCKET=your_private_bucket_name
R2_PUBLIC_BUCKET=your_public_bucket_name
R2_PUBLIC_URL=your_r2_public_access_url

# --- DOWNLOADS (External source: DJ Drive/MediaFire link -> MixMint signed URL) ---
# Optional: Google Drive API key for public-file fetch (else direct-download fallback).
GOOGLE_DRIVE_API_KEY=

# --- TELEGRAM SUPPORT (tickets ping admins; contact page deep link) ---
# 1. @BotFather -> /newbot -> token below. 2. Message the bot, then get your
# chat id via https://api.telegram.org/bot<TOKEN>/getUpdates -> ADMIN_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=mixmint_support_bot

# --- EMAIL (Resend) ---
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com

# --- DOWNLOADS ---
# proxy | auto | presigned. Default: auto on Vercel (files over DOWNLOAD_PROXY_MAX_MB go via a
# 2-minute R2 signed URL so function time limits never cut a download), proxy elsewhere.
# DOWNLOAD_DELIVERY=auto
# DOWNLOAD_PROXY_MAX_MB=40

# --- CRON & SECURITY ---
# Vercel Cron sends this automatically as `Authorization: Bearer <CRON_SECRET>` (see vercel.json).
CRON_SECRET=your_random_string_for_cron_protection
ADMIN_EMAIL=admin@mixmint.site

# --- CELERY (Redis) ---
CELERY_BROKER_URL=redis://localhost:6379/0
# FREE-TIER MODE (Render-free etc): no Redis/worker needed. Set True and run
# scheduled jobs via cron-job.org hitting /cron/<job>/?secret=<CRON_SECRET>.
# Jobs: cleanup (10min), warm-cache (30min), weekly-sales (daily),
# payout-cron (daily), ad-floor (weekly), reset-quotas (monthly),
# release-escrow (hourly), payouts (weekly). Send the secret as header X-Cron-Secret.
CELERY_TASK_ALWAYS_EAGER=False
# NOTE: on Vercel, eager mode auto-enables (serverless has no workers).
